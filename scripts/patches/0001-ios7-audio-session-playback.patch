 		[iOS7AppDelegate setKeyWindow:[[UIWindow alloc] initWithFrame:rect]];
 	}
 
+	// Dune patch: without an explicit category the app gets SoloAmbient, which
+	// the ring/silent switch mutes completely. A game whose speech and music
+	// carry the story should be heard like a media player, so ask for Playback
+	// and activate the session before the AudioQueue is created.
+	NSError *audioError = nil;
+	AVAudioSession *audioSession = [AVAudioSession sharedInstance];
+	if (![audioSession setCategory:AVAudioSessionCategoryPlayback error:&audioError])
+		NSLog(@"ScummVM: could not set the audio session category: %@", audioError);
+	if (![audioSession setActive:YES error:&audioError])
+		NSLog(@"ScummVM: could not activate the audio session: %@", audioError);
+
 	// Force creation of the shared instance on the main thread
 	iOS7_buildSharedOSystemInstance();
 
--- a/backends/platform/ios7/ios7_osys_sound.cpp	2026-09-16 01:21:25
