@@ -83,8 +83,17 @@
 	}
 
 	AudioQueueSetParameter(s_AudioQueue.queue, kAudioQueueParam_Volume, 1.0);
-	if (AudioQueueStart(s_AudioQueue.queue, NULL)) {
-		printf("Error starting the AudioQueue!\n");
+	// Dune patch: starting can fail transiently while the audio session is
+	// still being handed back to us (after an interruption, Control Centre, a
+	// screen recording starting). One failure used to leave the whole session
+	// silent, so try a few times before giving up.
+	OSStatus startStatus = AudioQueueStart(s_AudioQueue.queue, NULL);
+	for (int attempt = 0; startStatus && attempt < 10; ++attempt) {
+		usleep(100000);
+		startStatus = AudioQueueStart(s_AudioQueue.queue, NULL);
+	}
+	if (startStatus) {
+		printf("Error starting the AudioQueue! (%d)\n", (int)startStatus);
 		_mixer->setReady(false);
 		return;
 	}
